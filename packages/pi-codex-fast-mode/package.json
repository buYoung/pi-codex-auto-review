{
    "name": "@buyong/pi-codex-fast-mode",
    "version": "0.1.1",
    "description": "OpenAI Fast and Ultrafast service tiers for Pi, with commands, model-aware activation, and persistent settings.",
    "license": "Apache-2.0",
    "keywords": [
        "pi-package",
        "pi-extension",
        "codex",
        "openai",
        "fast-mode"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/buYoung/pi-codex-auto-review.git",
        "directory": "packages/pi-codex-fast-mode"
    },
    "homepage": "https://github.com/buYoung/pi-codex-auto-review/tree/master/packages/pi-codex-fast-mode#readme",
    "bugs": {
        "url": "https://github.com/buYoung/pi-codex-auto-review/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "pi": {
        "extensions": [
            "./dist/index.js"
        ]
    },
    "scripts": {
        "build": "tsc",
        "prepack": "tsc && node ../../scripts/package-shared-files.mjs copy && node ../../scripts/check-package.mjs .",
        "postpack": "node ../../scripts/package-shared-files.mjs remove"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": ">=1.0.0",
        "@earendil-works/pi-tui": ">=1.0.0"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "1.1.0",
        "@earendil-works/pi-tui": "1.1.0",
        "@types/node": "24.0.0",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "README.md",
        "README.ko.md",
        "LICENSE"
    ],
    "sharedFiles": [
        "LICENSE"
    ]
}
