{
    "name": "@buyong/pi-codex-image-gen",
    "version": "0.2.2",
    "description": "Codex-compatible image_gen tool for Pi using Pi's openai-codex ChatGPT subscription login for image requests, without changing the chat provider. Bundles the adapted imagegen skill.",
    "license": "Apache-2.0",
    "keywords": [
        "pi-package",
        "pi-extension",
        "image-generation",
        "gpt-image"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/buYoung/pi-codex-auto-review.git",
        "directory": "packages/pi-codex-image-gen"
    },
    "homepage": "https://github.com/buYoung/pi-codex-auto-review/tree/master/packages/pi-codex-image-gen#readme",
    "bugs": {
        "url": "https://github.com/buYoung/pi-codex-auto-review/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "pi": {
        "extensions": [
            "./dist/index.js"
        ],
        "skills": [
            "./skills"
        ]
    },
    "scripts": {
        "build": "tsc",
        "prepack": "tsc && node ../../scripts/package-shared-files.mjs copy && node ../../scripts/check-package.mjs .",
        "postpack": "node ../../scripts/package-shared-files.mjs remove"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": ">=0.99.1",
        "@earendil-works/pi-coding-agent": ">=0.99.1",
        "@earendil-works/pi-tui": ">=0.99.1"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "0.99.1",
        "@earendil-works/pi-coding-agent": "0.99.1",
        "@earendil-works/pi-tui": "0.99.1",
        "@types/node": "24.0.0",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "README.md",
        "README.ko.md",
        "LICENSE",
        "skills/**/*.md",
        "skills/**/LICENSE.txt",
        "skills/**/NOTICE"
    ],
    "sharedFiles": [
        "LICENSE"
    ]
}
