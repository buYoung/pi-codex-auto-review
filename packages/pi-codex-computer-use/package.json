{
    "name": "@buyong/pi-codex-computer-use",
    "version": "0.1.2",
    "description": "Codex Computer Use and Browser Use for Pi. Runs the runtime installed by the Codex Desktop app with the same host flow Codex uses; nothing from OpenAI is bundled.",
    "license": "Apache-2.0",
    "keywords": [
        "pi-package",
        "pi-extension",
        "codex",
        "computer-use",
        "browser-use"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/buYoung/pi-codex-auto-review.git",
        "directory": "packages/pi-codex-computer-use"
    },
    "homepage": "https://github.com/buYoung/pi-codex-auto-review/tree/master/packages/pi-codex-computer-use#readme",
    "bugs": {
        "url": "https://github.com/buYoung/pi-codex-auto-review/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "pi": {
        "extensions": [
            "./dist/index.js"
        ]
    },
    "scripts": {
        "build": "tsc",
        "prepack": "tsc && node ../../scripts/package-shared-files.mjs copy && node ../../scripts/check-package.mjs .",
        "postpack": "node ../../scripts/package-shared-files.mjs remove"
    },
    "dependencies": {
        "@earendil-works/pi-mcp": "1.1.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": ">=1.0.0",
        "@earendil-works/pi-coding-agent": ">=1.0.0",
        "@earendil-works/pi-tui": ">=1.0.0"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "1.1.0",
        "@earendil-works/pi-coding-agent": "1.1.0",
        "@earendil-works/pi-tui": "1.1.0",
        "@sinclair/typebox": "0.34.52",
        "@types/node": "24.0.0",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "README.md",
        "README.ko.md",
        "LICENSE",
        "NOTICE",
        "docs/computer-use/usage.md",
        "docs/computer-use/usage.ko.md"
    ],
    "sharedFiles": [
        "LICENSE",
        "docs/computer-use/usage.md",
        "docs/computer-use/usage.ko.md"
    ]
}
