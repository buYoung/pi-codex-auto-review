{
    "$schema": "https://unpkg.com/release-it@21.0.1/schema/release-it.json",
    "git": {
        "requireBranch": "master",
        "tagName": "v${version}",
        "tagMatch": "v[0-9]*",
        "commitMessage": "chore(${version} 릴리스): ${branchName}\n\n1. 패키지 버전 ${version}의 출시를 기록합니다.\n2. 버전 태그로 GitHub Actions의 npm 게시를 시작합니다.",
        "tagAnnotation": "pi-codex-auto-review ${version}"
    },
    "npm": {
        "publish": false,
        "versionArgs": ["--ignore-scripts", "--workspaces-update=false"]
    }
}
