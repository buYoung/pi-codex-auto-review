{
    "name": "buyong-pi",
    "private": true,
    "license": "Apache-2.0",
    "workspaces": [
        "packages/*"
    ],
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "^11.5.1",
            "onFail": "warn"
        }
    },
    "scripts": {
        "prepare": "husky",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "check:staged": "lint-staged",
        "release": "node scripts/release.mjs",
        "build": "turbo run build",
        "test:contracts": "node scripts/run-tests.mjs contracts",
        "test:policy": "node scripts/run-tests.mjs policy",
        "test:reviewer": "node scripts/run-tests.mjs reviewer",
        "test:approvals": "node scripts/run-tests.mjs approvals",
        "test:execution": "node scripts/run-tests.mjs execution",
        "test:integration": "node scripts/run-tests.mjs integration",
        "test:e2e": "node scripts/run-tests.mjs e2e",
        "test:conformance": "node scripts/run-tests.mjs conformance",
        "verify:guard": "node scripts/verify-guard.mjs",
        "verify:platform": "node scripts/verify-platform.mjs",
        "verify:windows": "node scripts/verify-windows.mjs",
        "verify:docker": "node scripts/verify-docker.mjs"
    },
    "lint-staged": {
        "*": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@inquirer/prompts": "8.5.2",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "pi-ollama-cloud": "0.12.2",
        "release-it": "21.0.1",
        "semver": "7.8.5",
        "turbo": "2.11.7"
    },
    "overrides": {
        "@earendil-works/pi-ai": "0.99.1",
        "@earendil-works/pi-agent-core": "0.99.1",
        "@earendil-works/pi-tui": "0.99.1",
        "brace-expansion": "5.0.12"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
